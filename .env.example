# =============================================================================
# TELEGRAM BOT CONFIGURATION
# =============================================================================
# Get your token from @BotFather on Telegram
TELEGRAM_TOKEN=your_telegram_bot_token_here

# =============================================================================
# OPENROUTER API CONFIGURATION
# =============================================================================
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Specify a default model (leave empty to use auto-selection)
# Examples: "meta-llama/llama-3.1-8b-instruct", "google/gemini-flash-1.5"
OPENROUTER_MODEL=''


HUGGINGFACE_TOKEN=''

# =============================================================================
# CLOUDFLARE WORKER PROXY (Optional but Recommended)
# =============================================================================
# Your Cloudflare Worker URL for Telegram API proxying
# Format: https://your-worker-name.your-subdomain.workers.dev
WORKER_URL=https://your-worker.workers.dev

# =============================================================================
# NOTES:
# =============================================================================
# 1. Copy this file to .env and fill in your actual values
# 2. Never commit .env to Git - it's already in .gitignore
# 3. All values are required except OPENROUTER_MODEL (optional)

DEEPSEEK_API_KEY=get an api key from https://platform.deepseek.com/api_keys